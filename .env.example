DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres URL used in production only (config.settings.prod).
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Comma-separated list of full origins, e.g. https://nabecnetworks.co.ke
CSRF_TRUSTED_ORIGINS=

# Where contact-form submissions are emailed (in addition to being saved to the DB).
CONTACT_NOTIFY_EMAIL=info@nabecnetworks.co.ke

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Nabec Networks Connection <no-reply@nabecnetworks.co.ke>
