DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Change in production to reduce automated bot traffic against /admin/.
ADMIN_URL=admin

# Postgres URL used in production only (config.settings.prod).
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Comma-separated list of full origins, e.g. https://nabec.co.ke
CSRF_TRUSTED_ORIGINS=

# Where contact-form submissions are emailed (in addition to being saved to the DB).
CONTACT_NOTIFY_EMAIL=info@nabec.co.ke

# To email contact-form messages, use Brevo (free plan): EMAIL_HOST=smtp-relay.brevo.com, EMAIL_HOST_USER = the Brevo SMTP login, EMAIL_HOST_PASSWORD = a Brevo SMTP key.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Nabec Networks Connection <info@nabec.co.ke>
